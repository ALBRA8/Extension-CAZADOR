{
  "name": "cazador-extension",
  "version": "0.1.0",
  "description": "Cazador — Extensión Chrome para scrapear webs con IA en 2 clics: sugerencia automática de columnas, créditos transparentes y export a CSV/Excel.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5",
    "lucide-react": "^0.456.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/chrome": "^0.0.279",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
